{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencard-feedback",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "opencard-feedback.reversewizard.site",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    // 反馈仓库刻意留在旧所有者名下：它是私有基础设施，用户侧看不到它在哪，
    // 而搬过去要在新账号上重装（甚至重建）GitHub App 并更新安装 ID —— 不值当。
    "GITHUB_OWNER": "POPCORNBOOM",
    "GITHUB_REPO": "OpenCard-reports",
    "ALLOWED_ORIGINS": "http://tauri.localhost,https://tauri.localhost,tauri://localhost,http://localhost:1420"
  },
  "d1_databases": [
    {
      "binding": "RECEIPTS_DB",
      "database_name": "opencard-feedback-receipts",
      "database_id": "ca78f3d2-0216-4c80-9981-1540aed82f15",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "FEEDBACK_RATE_LIMIT",
      "namespace_id": "61001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
