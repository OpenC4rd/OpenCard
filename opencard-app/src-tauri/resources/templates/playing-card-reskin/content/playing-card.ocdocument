{
  "type": "card-document",
  "id": "doc-playing-card-reskin",
  "name": "换皮扑克牌",
  "version": "1.0.0",
  "width": "540",
  "height": "756",
  "faces": {
    "front": {
      "type": "card-face",
      "id": "card-face-playing-card-front",
      "background": "#15171b",
      "children": [
    {
      "block": {
        "id": "playing-card-root",
        "type": "simple-container-block",
        "name": "扑克牌皮肤 / 编辑自定义字段",
        "paper": "#f4efe4",
        "ink": "#17191d",
        "accent": "#c43c4b",
        "rank": "A",
        "suit": "♠",
        "series": "OPENCARD PLAYING CO.",
        "width": "500px",
        "height": "716px",
        "clip": "false",
        "background": "{{self:paper}}",
        "borderColor": "{{self:ink}}",
        "borderWidth": "2",
        "borderStyle": "solid",
        "borderRadius": "28px",
        "customCss": "overflow: hidden; box-sizing: border-box; box-shadow: inset 0 0 0 8px rgba(255,255,255,0.22), 0 18px 42px rgba(0,0,0,0.28); font-family: Georgia, 'Times New Roman', serif;",
        "additionalFieldDefinition": {
          "paper": { "fieldType": "color", "title": "纸张" },
          "ink": { "fieldType": "color", "title": "墨色" },
          "accent": { "fieldType": "color", "title": "强调色" },
          "rank": { "fieldType": "string", "title": "点数" },
          "suit": { "fieldType": "string", "title": "花色" },
          "series": { "fieldType": "string", "title": "系列标识" }
        },
        "children": [
          {
            "block": {
              "id": "playing-card-inner-frame",
              "type": "simple-container-block",
              "name": "装饰内框",
              "width": "448px",
              "height": "664px",
              "background": "transparent",
              "borderColor": "{{parent:accent}}",
              "borderWidth": "2",
              "borderStyle": "solid",
              "borderRadius": "18px",
              "clip": "false",
              "customCss": "box-sizing: border-box; opacity: 0.78; box-shadow: inset 0 0 0 5px rgba(255,255,255,0.12);",
              "children": []
            },
            "location": {
              "id": "loc-playing-card-inner-frame",
              "type": "simple-container-location",
              "anchor": "cc",
              "x": "0px",
              "y": "0px"
            }
          },
          {
            "block": {
              "id": "playing-card-top-rank",
              "type": "text-block",
              "name": "左上点数",
              "content": "<p><span data-oc-binding=\"parent:rank\">{{parent:rank}}</span></p>",
              "width": "72px",
              "height": "66px",
              "fontSize": "56px",
              "fontWeight": "bold",
              "color": "{{parent:ink}}",
              "textAlign": "center",
              "lineHeight": "66px"
            },
            "location": {
              "id": "loc-playing-card-top-rank",
              "type": "simple-container-location",
              "anchor": "lt",
              "x": "26px",
              "y": "24px"
            }
          },
          {
            "block": {
              "id": "playing-card-top-suit",
              "type": "text-block",
              "name": "左上花色",
              "content": "<p><span data-oc-binding=\"parent:suit\">{{parent:suit}}</span></p>",
              "width": "72px",
              "height": "54px",
              "fontSize": "44px",
              "fontWeight": "bold",
              "color": "{{parent:accent}}",
              "textAlign": "center",
              "lineHeight": "54px"
            },
            "location": {
              "id": "loc-playing-card-top-suit",
              "type": "simple-container-location",
              "anchor": "lt",
              "x": "26px",
              "y": "84px"
            }
          },
          {
            "block": {
              "id": "playing-card-center-suit",
              "type": "text-block",
              "name": "中心花色",
              "content": "<p><span data-oc-binding=\"parent:suit\">{{parent:suit}}</span></p>",
              "width": "270px",
              "height": "300px",
              "fontSize": "240px",
              "fontWeight": "bold",
              "color": "{{parent:accent}}",
              "textAlign": "center",
              "verticalAlign": "center",
              "lineHeight": "300px",
              "customCss": "filter: drop-shadow(0 10px 0 rgba(0,0,0,0.08));"
            },
            "location": {
              "id": "loc-playing-card-center-suit",
              "type": "simple-container-location",
              "anchor": "cc",
              "x": "0px",
              "y": "4px"
            }
          },
          {
            "block": {
              "id": "playing-card-bottom-mark",
              "type": "flow-container-block",
              "name": "右下旋转角标",
              "rank": "{{parent:rank}}",
              "suit": "{{parent:suit}}",
              "ink": "{{parent:ink}}",
              "accent": "{{parent:accent}}",
              "direction": "tb",
              "gap": "0px",
              "clip": "false",
              "width": "72px",
              "height": "120px",
              "rotation": "180",
              "additionalFieldDefinition": {
                "rank": { "fieldType": "string", "title": "点数" },
                "suit": { "fieldType": "string", "title": "花色" },
                "ink": { "fieldType": "string", "title": "墨色" },
                "accent": { "fieldType": "string", "title": "强调色" }
              },
              "children": [
                {
                  "block": {
                    "id": "playing-card-bottom-rank",
                    "type": "text-block",
                    "name": "右下点数",
                    "content": "<p><span data-oc-binding=\"parent:rank\">{{parent:rank}}</span></p>",
                    "width": "72px",
                    "height": "66px",
                    "fontSize": "56px",
                    "fontWeight": "bold",
                    "color": "{{parent:ink}}",
                    "textAlign": "center",
                    "lineHeight": "66px"
                  },
                  "location": {
                    "id": "loc-playing-card-bottom-rank",
                    "type": "flow-container-location",
                    "index": "0",
                    "align": "center"
                  }
                },
                {
                  "block": {
                    "id": "playing-card-bottom-suit",
                    "type": "text-block",
                    "name": "右下花色",
                    "content": "<p><span data-oc-binding=\"parent:suit\">{{parent:suit}}</span></p>",
                    "width": "72px",
                    "height": "54px",
                    "fontSize": "44px",
                    "fontWeight": "bold",
                    "color": "{{parent:accent}}",
                    "textAlign": "center",
                    "lineHeight": "54px"
                  },
                  "location": {
                    "id": "loc-playing-card-bottom-suit",
                    "type": "flow-container-location",
                    "index": "1",
                    "align": "center"
                  }
                }
              ]
            },
            "location": {
              "id": "loc-playing-card-bottom-mark",
              "type": "simple-container-location",
              "anchor": "rb",
              "x": "-26px",
              "y": "-24px"
            }
          },
          {
            "block": {
              "id": "playing-card-series",
              "type": "text-block",
              "name": "系列标识",
              "content": "<p><span data-oc-binding=\"parent:series\">{{parent:series}}</span></p>",
              "width": "270px",
              "height": "24px",
              "fontSize": "11px",
              "fontFamily": "ui-monospace",
              "fontWeight": "bold",
              "color": "{{parent:ink}}",
              "textAlign": "center",
              "lineHeight": "24px",
              "customCss": "letter-spacing: 3px; opacity: 0.58;"
            },
            "location": {
              "id": "loc-playing-card-series",
              "type": "simple-container-location",
              "anchor": "cb",
              "x": "0px",
              "y": "-28px"
            }
          }
        ]
      },
      "location": {
        "id": "loc-playing-card-root",
        "type": "simple-container-location",
        "anchor": "cc",
        "x": "0px",
        "y": "0px"
      }
    }
      ]
    },
    "back": {
      "type": "card-face",
      "id": "card-face-playing-card-back",
      "background": "#15171b",
      "children": []
    }
  },
  "instances": [
    {
      "type": "card-instance",
      "id": "playing-card-spade-ace",
      "name": "黑桃 A / 午夜紫",
      "amount": "1",
      "data": {
        "playing-card-root": {
          "paper": "#f3efe6",
          "ink": "#17191d",
          "accent": "#6857d9",
          "rank": "A",
          "suit": "♠",
          "series": "MIDNIGHT EDITION"
        }
      }
    },
    {
      "type": "card-instance",
      "id": "playing-card-heart-king",
      "name": "红心 K / 绯红",
      "amount": "1",
      "data": {
        "playing-card-root": {
          "paper": "#fff4ed",
          "ink": "#4a1820",
          "accent": "#cf304a",
          "rank": "K",
          "suit": "♥",
          "series": "CRIMSON EDITION"
        }
      }
    },
    {
      "type": "card-instance",
      "id": "playing-card-club-queen",
      "name": "梅花 Q / 翡翠",
      "amount": "1",
      "data": {
        "playing-card-root": {
          "paper": "#edf4e8",
          "ink": "#17332a",
          "accent": "#19856b",
          "rank": "Q",
          "suit": "♣",
          "series": "VERDANT EDITION"
        }
      }
    },
    {
      "type": "card-instance",
      "id": "playing-card-diamond-jack",
      "name": "方块 J / 琥珀",
      "amount": "1",
      "data": {
        "playing-card-root": {
          "paper": "#fff4d6",
          "ink": "#44250b",
          "accent": "#d57a16",
          "rank": "J",
          "suit": "♦",
          "series": "AMBER EDITION"
        }
      }
    }
  ]
}
