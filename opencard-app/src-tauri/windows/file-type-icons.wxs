<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI 的文件关联只声明了 ProgId 与 Verb，没有写任何 DefaultIcon（见 Tauri 的 main.wxs 模板），
  所以 .ocpack 在 MSI 安装后是空白图标。这个片段把资源包的图标指向随应用分发的
  icons\ocpack.ico；片段通过 tauri.conf.json 的 bundle.windows.wix.componentGroupRefs 挂到安装器的功能组里。
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <ComponentGroup Id="OpenCardFileTypeIcons">
      <Component Id="OpenCardResourcePackageIcon" Directory="INSTALLDIR"
        Guid="C497109C-A77B-4DB5-B487-5D5005E021D8">
        <RegistryValue Root="HKCR" Key="OpenCard.ocpack\DefaultIcon" Type="string"
          Value="&quot;[INSTALLDIR]icons\ocpack.ico&quot;,0" KeyPath="yes" />
        <RegistryValue Root="HKCR" Key=".ocpack\DefaultIcon" Type="string"
          Value="&quot;[INSTALLDIR]icons\ocpack.ico&quot;,0" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
