{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCard",
  "version": "0.4.8",
  "identifier": "per.yiguwang.opencard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenCard",
        "decorations": false,
        "transparent": true,
        "minWidth": 1280,
        "minHeight": 720,
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "shortDescription": "Visual card design and template workspace",
    "longDescription": "OpenCard is a visual workspace for designing cards, managing reusable templates, and exporting finished card assets.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "ocdocument"
        ],
        "name": "OpenCard Card Document",
        "description": "OpenCard card document",
        "mimeType": "application/vnd.opencard.card+json",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "per.yiguwang.opencard.card",
          "conformsTo": [
            "public.json"
          ]
        }
      },
      {
        "ext": [
          "ocblock"
        ],
        "name": "OpenCard Custom Block",
        "description": "OpenCard custom block structure",
        "mimeType": "application/vnd.opencard.custom-block+json",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "per.yiguwang.opencard.custom-block",
          "conformsTo": [
            "public.json"
          ]
        }
      },
      {
        "ext": [
          "ocpack"
        ],
        "name": "OpenCard Resource Package",
        "description": "OpenCard package",
        "mimeType": "application/vnd.opencard.resource-package+zip",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "per.yiguwang.opencard.resource-package",
          "conformsTo": [
            "public.zip-archive"
          ]
        }
      },
      {
        "ext": [
          "octemplate"
        ],
        "name": "OpenCard Project Template",
        "description": "OpenCard project template package",
        "mimeType": "application/vnd.opencard.project-template+zip",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "per.yiguwang.opencard.project-template",
          "conformsTo": [
            "public.zip-archive"
          ]
        }
      },
      {
        "ext": [
          "ociconpack"
        ],
        "name": "OpenCard Icon Pack",
        "description": "OpenCard icon pack",
        "mimeType": "application/vnd.opencard.icon-pack+zip",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "per.yiguwang.opencard.icon-pack",
          "conformsTo": [
            "public.zip-archive"
          ]
        }
      }
    ],
    "resources": {
      "icons/ocblock.ico": "icons/ocblock.ico",
      "icons/ocpack.ico": "icons/ocpack.ico",
      "resources/packages/": "packages/",
      "resources/templates/": "templates/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": [
          "windows/file-type-icons.wxs"
        ],
        "componentGroupRefs": [
          "OpenCardFileTypeIcons"
        ]
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1NzYwNjI3MkVDQkU0QkEKUldTNjVNc3VKd1oycGZncGQveWlSUGUvZ1BDQk5IcndhYy9JMjE0bzF2Sll2aEN0dHFHR0xNOGgK",
      "endpoints": [
        "https://github.com/OpenC4rd/OpenCard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
